# Copy to .env and edit. Never commit .env.
PORT=3000

# Session cookie signing secret. Set a long random string in production.
# If unset, a random one is generated at startup (everyone is logged out on restart).
SESSION_SECRET=

# CRM login. TEST DEFAULT is admin / admin — change both before going live.
CRM_ADMIN_USER=admin
CRM_ADMIN_PASSWORD=admin

# MongoDB (required on Vercel). Without it the CRM uses a local JSON file and in-memory sessions,
# which is fine for local development but is lost on a serverless host.
# Atlas example: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/
MONGODB_URI=
# Database name (default: nouvelle)
MONGODB_DB=nouvelle

# Email notification for the website contact form (Gmail SMTP).
# GMAIL_APP_PASSWORD is a Google "App Password" (needs 2-Step Verification), NOT your Gmail password.
# Leave blank to skip emails (messages are still saved).
GMAIL_EMAIL=
GMAIL_APP_PASSWORD=
# Who receives the notification (default: the sending address). Comma-separate for several:
# MAIL_TO=a@example.com,b@example.com   (GMAIL_TO also works)
MAIL_TO=
