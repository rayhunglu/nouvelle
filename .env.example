# Copy to .env and edit. Never commit .env.
PORT=3000

# Secret that signs the session cookie. REQUIRED on Vercel (all instances must share it). Make one: node scripts/generate-secret.cjs
# Without it a random one is made at every start (fine locally: a restart signs everyone out).
SESSION_SECRET=

# CRM login. Optional built-in manager (off unless BOTH are set; there is no default). Prefer a database account: node scripts/make-admin.cjs
#CRM_ADMIN_USER=
#CRM_ADMIN_PASSWORD=

# MongoDB (required on Vercel). Without it the CRM uses a local JSON file and in-memory sessions,
# which is fine for local development but is lost on a serverless host.
# Atlas example (with user name and password): mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/nouvelle
# MONGODB_URI also works as the name.
MONGO_URL=
# Database name (default: the one in the URL path, otherwise "nouvelle")
MONGO_DB=nouvelle
# Other origins allowed to read the API from a browser (comma-separated). The site itself is always allowed.
CORS_ORIGIN=

# Email notification for the website contact form (Gmail SMTP).
# GMAIL_APP_PASSWORD is a Google "App Password" (needs 2-Step Verification), NOT your Gmail password.
# Leave blank to skip emails (messages are still saved).
GMAIL_EMAIL=
GMAIL_APP_PASSWORD=
# Who receives the notification (default: the sending address). Comma-separate for several:
# MAIL_TO=a@example.com,b@example.com   (GMAIL_TO also works)
MAIL_TO=
# Job applications (with the resume attached) go to CAREERS_MAIL_TO; falls back to MAIL_TO when empty.
CAREERS_MAIL_TO=

# Optional text-message alert through the carrier's email-to-SMS gateway (sent from the Gmail above).
# Digits only uses SMS_GATEWAY (default tmomail.net = T-Mobile); or give full addresses, comma-separated.
SMS_TO=
SMS_GATEWAY=

# development = local http (session cookie not Secure); leave unset or "production" when deployed
NODE_ENV=

# Public address of the site, used in emailed password links (default: the address the request came in on)
APP_URL=
